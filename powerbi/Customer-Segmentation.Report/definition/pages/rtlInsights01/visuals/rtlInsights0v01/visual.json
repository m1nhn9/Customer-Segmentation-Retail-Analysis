              },
              {
                "textRuns": [
                  {
                    "value": "▸ ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#1F2A44"
                    }
                  },
                  {
                    "value": "Champions carry the business. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#252423"
                    }
                  },
                  {
                    "value": "718 customers (16.6%) generate £5.75M, 64.7% of all revenue, at ~£8,000 each.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "▸ ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#1F2A44"
                    }
                  },
                  {
                    "value": "At-Risk is the biggest group but the smallest earner per head. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#252423"
                    }
                  },
                  {
                    "value": "1,549 customers (35.7%) bring in 6.3% of revenue; on average they last bought ~192 days ago.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "▸ ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#1F2A44"
                    }
                  },
                  {
                    "value": "Loyalists are the upgrade pool. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#252423"
                    }
                  },
                  {
                    "value": "1,174 customers add 24.1% of revenue (£2.14M); nudging them toward Champion behaviour is the biggest lever.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "▸ ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#1F2A44"
                    }
                  },
                  {
                    "value": "Revenue builds into Q4. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#252423"
                    }
                  },
                  {
                    "value": "Monthly revenue climbs from ~£0.6M to £1.16M in Nov 2011 (Dec 2011 is a partial month).",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "▸ ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#1F2A44"
                    }
                  },
                  {
                    "value": "The UK accounts for 82% of revenue. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#252423"
                    }
                  },
                  {
                    "value": "The Netherlands, EIRE and Germany are next at ~3% each.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#605E5C"
