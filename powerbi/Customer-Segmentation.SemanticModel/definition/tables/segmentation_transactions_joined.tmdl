		lineageTag: 074d0af0-4e01-45ce-801c-990b0cbc14dd
		summarizeBy: sum
		sourceColumn: line_item_total

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

