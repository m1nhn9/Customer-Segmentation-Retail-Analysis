		summarizeBy: none
		sourceColumn: segment

		annotation SummarizationSetBy = Automatic

	column 'Invoice Month' = DATE(YEAR([invoice_date]), MONTH([invoice_date]), 1)
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 0c2d1c1b-e44c-4342-812b-29d66f460414
		summarizeBy: none

	partition segmentation_transactions_joined = m
		mode: import
		source =
				  let
				    Transactions = Table.PromoteHeaders(Csv.Document(File.Contents(DataFolder & "clean_transactions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true]),
				    Segments = Table.PromoteHeaders(Csv.Document(File.Contents(DataFolder & "rfm_segments.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true]),
				    Joined = Table.NestedJoin(Transactions, {"customer_id"}, Segments, {"customer_id"}, "rfm", JoinKind.Inner),
				    Expanded = Table.ExpandTableColumn(Joined, "rfm", {"recency", "frequency", "monetary", "Cluster", "segment"}),
				    #"Changed column type" = Table.TransformColumnTypes(Expanded, {{"invoice_no", Int64.Type}, {"stock_code", type text}, {"description", type text}, {"quantity", Int64.Type}, {"invoice_date", type datetime}, {"unit_price", type number}, {"customer_id", Int64.Type}, {"country", type text}, {"line_item_total", type number}, {"recency", Int64.Type}, {"frequency", Int64.Type}, {"monetary", type number}, {"Cluster", Int64.Type}, {"segment", type text}})
				  in
				    #"Changed column type"

	annotation PBI_ResultType = Table

