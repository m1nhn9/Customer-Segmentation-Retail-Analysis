table segmentation_transactions_joined
	lineageTag: e7c9bb37-898f-42b9-bb7a-9fe82bfae254

	measure Revenue = SUM(segmentation_transactions_joined[line_item_total])
		formatString: £#,0
		lineageTag: ed147497-b4ba-48ab-a22b-800244d3c7be

	measure Customers = DISTINCTCOUNT(segmentation_transactions_joined[customer_id])
		formatString: #,0
		lineageTag: eb418895-f387-4908-b861-10698a5eb15f

	measure '% of Revenue' = DIVIDE([Revenue], CALCULATE([Revenue], ALL(segmentation_transactions_joined[segment])))
		formatString: 0.0%
		lineageTag: 4fc12c39-f45e-464a-9cf8-e6ef4e0f6c73

	measure '% of Customers' = DIVIDE([Customers], CALCULATE([Customers], ALL(segmentation_transactions_joined[segment])))
		formatString: 0.0%
		lineageTag: 65ddda7e-ec58-4edb-9bfc-9722ae75b789

	measure 'Revenue per Customer' = DIVIDE([Revenue], [Customers])
		formatString: £#,0
		lineageTag: c73c5008-00f3-43c3-a554-353bab5e110e

	measure 'Avg Recency (days)' = AVERAGEX(VALUES(segmentation_transactions_joined[customer_id]), CALCULATE(MAX(segmentation_transactions_joined[recency])))
		formatString: #,0
		lineageTag: 239284d8-f78a-4fec-b13d-b5cecc1568eb

	measure 'Avg Orders' = AVERAGEX(VALUES(segmentation_transactions_joined[customer_id]), CALCULATE(MAX(segmentation_transactions_joined[frequency])))
		formatString: #,0.0
		lineageTag: 0b5faf99-cafc-4f04-b186-3591983dbcf0

	measure 'Avg Spend' = AVERAGEX(VALUES(segmentation_transactions_joined[customer_id]), CALCULATE(MAX(segmentation_transactions_joined[monetary])))
		formatString: £#,0
		lineageTag: 5ac4e4f1-9902-4e76-ba28-a61b8c8884dc

	measure 'Recommended Action' = SWITCH(SELECTEDVALUE(segmentation_transactions_joined[segment]), "Champions", "Reward and retain: VIP perks, early access, referral asks", "Loyalists", "Upsell and cross-sell; nudge toward Champion tier", "New / Recent", "Onboard: welcome series and a second-purchase incentive", "At-Risk", "Win back: personalised reactivation offers before they lapse")
		lineageTag: 7f6c6fd8-523d-49bd-984f-7afe6605e0ce

	measure 'Revenue (Top 10 Countries)' =
			VAR r = RANKX(ALLSELECTED(segmentation_transactions_joined[country]), [Revenue], , DESC)
			RETURN IF(r <= 10, [Revenue])
		formatString: £#,0
		lineageTag: f505ccc1-c2eb-4d62-86ce-667e51241557

	measure 'Champions Revenue Share' = CALCULATE([% of Revenue], segmentation_transactions_joined[segment] = "Champions")
		formatString: 0.0%
		lineageTag: 875a8dd8-19b4-4d53-b41d-9f742382de7c

	measure 'At-Risk Customers' = CALCULATE([Customers], segmentation_transactions_joined[segment] = "At-Risk")
		formatString: #,0
		lineageTag: a1cc6c79-5c4c-4ff4-ac66-192a58eaa24a

	measure 'Customer Spend' = MAX(segmentation_transactions_joined[monetary])
		formatString: £#,0
		lineageTag: 21c59c5a-18da-4928-9e42-fae0a8e799ab

	measure 'Days Since Last Purchase' = MAX(segmentation_transactions_joined[recency])
		formatString: #,0
		lineageTag: 54d9ece5-04c7-41ff-871c-f81ff74b2fab

	measure Orders = MAX(segmentation_transactions_joined[frequency])
		formatString: #,0
		lineageTag: f40996c3-09df-4cda-91eb-02ff4a3fb345

	column invoice_no
		dataType: int64
		formatString: 0
		lineageTag: 6c08ea58-f167-4033-9028-a984b07a74b8
		summarizeBy: sum
		sourceColumn: invoice_no

		annotation SummarizationSetBy = Automatic

